# Runtime
NODE_ENV=development
# Full local/MVP behavior is the default. API-only preview requires only PG/Redis/auth.
APP_MODE=full
LOG_LEVEL=info
PORT=4000
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
HTTP_TRUST_PROXY_HOPS=0
# Browser-safe API base URL for the Next.js workspace. It contains no secret.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL
POSTGRES_DB=whatsapp_saas
POSTGRES_USER=whatsapp
POSTGRES_PASSWORD=whatsapp_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://whatsapp:whatsapp_local_only@localhost:5432/whatsapp_saas
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis and BullMQ
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=whatsapp-saas
WEBHOOK_RELAY_POLL_INTERVAL_MS=1000
WEBHOOK_QUEUE_CONCURRENCY=5
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE_DELAY_MS=1000
WEBHOOK_OUTBOX_LOCK_TIMEOUT_SECONDS=60
IMPORT_RELAY_POLL_INTERVAL_MS=1000
IMPORT_QUEUE_CONCURRENCY=1
IMPORT_MAX_ATTEMPTS=3
IMPORT_RETRY_BASE_DELAY_MS=5000
IMPORT_OUTBOX_LOCK_TIMEOUT_SECONDS=300
IMPORT_PROCESSING_TIMEOUT_SECONDS=900
MESSAGE_RELAY_POLL_INTERVAL_MS=1000
MESSAGE_QUEUE_CONCURRENCY=10
MESSAGE_OUTBOX_LOCK_TIMEOUT_SECONDS=60
MESSAGE_MAX_ATTEMPTS=5
MESSAGE_RETRY_BASE_DELAY_MS=1000

# Authentication and encryption
JWT_ACCESS_SECRET=
# Optional one-time first-Super-Admin API. Leave empty normally; remove after bootstrap.
BOOTSTRAP_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_PEPPER=
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=100
AUTH_LOGIN_EMAIL_LIMIT=10
DATA_ENCRYPTION_KEY=

# Meta WhatsApp Business Platform
WHATSAPP_ONBOARDING_MODE=development
# Server-only JSON map of key IDs to random 32-byte base64 keys. Never commit real keys.
WHATSAPP_CREDENTIAL_KEYRING=
WHATSAPP_CREDENTIAL_ACTIVE_KEY_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Development only. Keep the value in local .env or Railway variables; never commit it.
META_DEVELOPMENT_ACCESS_TOKEN=

# S3-compatible object storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=whatsapp-saas-local
S3_ACCESS_KEY_ID=whatsapp_local_access
S3_SECRET_ACCESS_KEY=whatsapp_local_secret
S3_FORCE_PATH_STYLE=true

# Malware scanning for imports
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000

# Local email capture
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@whatsapp-saas.local
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=500

# Upload limits
MAX_IMPORT_FILE_BYTES=10485760
MAX_IMPORT_FILE_ROWS=10000
IMPORT_RETENTION_DAYS=30
MAX_MEDIA_FILE_BYTES=16777216

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# One-time database bootstrap (required only by `pnpm schema:seed`)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_DISPLAY_NAME=
SEED_SUPER_ADMIN_PASSWORD=
SEED_TENANT_NAME=
SEED_TENANT_SLUG=
SEED_TENANT_TIMEZONE=
SEED_TENANT_COUNTRY_CODE=
SEED_TENANT_ADMIN_EMAIL=
SEED_TENANT_ADMIN_DISPLAY_NAME=
SEED_TENANT_ADMIN_PASSWORD=
SEED_TENANT_USER_EMAIL=
SEED_TENANT_USER_DISPLAY_NAME=
SEED_TENANT_USER_PASSWORD=
SEED_PLAN_MAX_USERS=100
SEED_PLAN_MAX_WHATSAPP_NUMBERS=10
SEED_PLAN_MAX_CONTACTS=100000
SEED_PLAN_MONTHLY_MESSAGE_LIMIT=1000000
SEED_PLAN_MONTHLY_CAMPAIGN_LIMIT=10000
SEED_PLAN_MAX_TEMPLATES=1000
SEED_PLAN_STORAGE_GB=100
SEED_PLAN_AUTOMATION_ENABLED=true
