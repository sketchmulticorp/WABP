{
  "name": "whatsapp-saas-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.7 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm schema:verify && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:build": "docker compose build web api worker",
    "infra:config": "docker compose config --quiet",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs --follow",
    "infra:migrate": "docker compose --profile operations run --rm migrate",
    "infra:reset": "docker compose down --volumes --remove-orphans",
    "infra:seed": "docker compose --profile operations run --rm seed",
    "infra:status": "docker compose ps --all",
    "infra:up": "docker compose up --detach --wait --build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "schema:verify": "node apps/api/database/verify-schema.mjs",
    "schema:drizzle:check": "pnpm --filter @whatsapp-platform/api db:check",
    "schema:drizzle:generate": "pnpm --filter @whatsapp-platform/api db:generate",
    "schema:migrate": "pnpm --filter @whatsapp-platform/api db:migrate",
    "schema:seed": "pnpm --filter @whatsapp-platform/api db:seed",
    "schema:test:integration": "pnpm --filter @whatsapp-platform/api test:database",
    "schema:validate:db": "node apps/api/database/run-schema-validation.mjs",
    "security:audit": "pnpm audit --prod --audit-level high",
    "security:audit:all": "pnpm audit --audit-level high",
    "test": "turbo run test && pnpm test:client && pnpm test:recovery:safety",
    "test:client": "node --test tests/unit/api-client.test.mjs",
    "test:recovery:safety": "node --test tests/unit/recovery-safety.test.mjs",
    "ops:recovery:local": "node --env-file-if-exists=.env infra/operations/recovery-drill.mjs",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "26.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
